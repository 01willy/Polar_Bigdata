# ============================================================
# Polar_Bigdata .gitignore
# 원칙: 코드·문서·작은 결과 CSV·시각화 산출물(그림/지도)은 추적,
#       대용량 원천/파생 데이터·모델 체크포인트·저작권 PDF는 제외.
# 제외된 대용량은 scripts/0_download·1_data_prep 로 재생성 가능.
# ============================================================

# --- 대용량 원천/중간 데이터 (재생성 가능) ---
data/raw/
data/interim/

# --- 대용량 파생 데이터 / 바이너리 아티팩트 ---
*.parquet
*.npy
*.npz
*.vti
*.vtp
data/processed/dl_dataset*.csv
data/processed/*_predictions.csv
data/processed/*fold_predictions*.csv
data/processed/*_oof.csv
data/processed/alt_era5_temporal.csv
data/processed/alt_above_pointlevel.csv
data/processed/dl_locations.csv
# (추적 유지: curated_scope_results / model_tournament_results / *_significance /
#  b0*_results / alt_global / ground_temp* 등 작은 결과·라벨 요약 CSV)

# --- 모델 체크포인트 (재학습 가능) ---
outputs/models/
*.pt
*.pth
*.ckpt

# --- 저작권 논문 PDF (README/INDEX .md만 추적, 하위폴더 포함 PDF 전부 제외) ---
references/*.pdf
references/**/*.pdf

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# --- 비밀/자격증명 (절대 커밋 금지) ---
.env
*.env
.netrc
*credential*
*secret*
.claude/settings.local.json

# --- 실행 로그 · 재생성 가능 렌더 PNG(용량) ---
logs/
deck/render/*.png
deck/assets/figs/_prev_*.png

# --- OS/에디터 ---
.DS_Store
*.swp

# --- 대회 KPDC 원본(저작권·raw, data/raw와 동급) ---
kpdc/
# --- 대용량 발표덱 렌더(빌드 스크립트로 재생성) ---
deck/render/*.pptx
deck/render/*.pdf
# --- 대용량 파생 격자/공변량 CSV(재생성 가능) ---
data/processed/shallow3d_alaska_grid.csv
data/processed/new_regions_covariates.csv

# S0 대용량 파생(재생성: build_fidelity_schema.py)
data/processed/fidelity_base.csv
data/processed/fidelity_observations_long.csv

# figures PDF는 대용량, PNG만 추적(재생성 가능)
outputs/figures/**/*.pdf

# 대용량 재생성물(tex/md에서 생성) — git 경량화
docs/report/*.pdf
docs/report/*.aux
docs/report/*.log
docs/report/*.out
outputs/*.docx

# 보고서 위치 이전(docs/report -> outputs/report) 반영
outputs/report/*.aux
outputs/report/*.log
outputs/report/*.out
outputs/report/*.docx
outputs/report/*.pdf
outputs/*.hwp
# CatBoost 학습 부산물
catboost_info/

# --- 참고용 대용량 입력물(외부 제공, 재배포 대상 아님) ---
CI_ai.zip
IMAGE_*.pptx
# --- 타 사업 문서(본 연구 산출물 아님) ---
outputs/report/*.pptx

# E3 대용량 파생(재생성: expand_calm_regions.py --attach, era5land_soil_tdd.py)
data/processed/fidelity_base_v2.csv
data/processed/e5_soil_tdd.csv

# Rescale 업로드 묶음(scripts/rescale/make_payload.sh 로 재생성)
work/

# LGF 파운데이션 모델 가상환경(전역 환경 보호용)
.venv_lgf/

# LGU 작업 조각과 실행 중 스레드 등록부(재생성 가능. 집계 표 lgu_*.csv 만 추적한다)
data/processed/lgu/shards/
data/processed/lgu/.running/
# 원자적 쓰기가 중단되면 남는 임시 파일(<이름>.tmp<pid>)
*.tmp[0-9]*

# 결과 전 계산·지도 격자·새 지역 실행의 큰 산출(재생성 가능)과 봉인 산출
data/processed/lgw/sealed/
data/processed/lgw/xenv/
data/processed/map_lena/*.csv.gz
data/processed/map_lena/cov_parts/
data/processed/map_lena/lena_grid_cells_v1.csv
data/processed/ext_labels/cov_parts/
data/processed/lgd/smoke/
data/processed/lgd/shards/
data/processed/lgf/shards/
data/processed/lgf/nsel/
data/processed/lgf/run_lgf*/
data/processed/lgu/shards/
data/processed/lgu/.running/
data/processed/lgd/run_tables/
